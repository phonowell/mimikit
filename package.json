  "license": "MIT",
  "scripts": {
    "lint": "pnpm run guard:file-length && tsx scripts/remove-bom.ts && tsx scripts/fix-crlf.ts && tsx scripts/format-jsdoc.ts && tsx scripts/fn-to-arrow.ts && tsx scripts/prompt-hardcode-guard.ts && eslint \"src/**/*.ts\" \"webui-src/**/*.{ts,tsx}\" --fix",
    "lint:changed-tests": "tsx scripts/lint-changed-tests.ts",
    "prompt:preview": "tsx scripts/preview-prompt.ts",
    "start": "tsx scripts/start.ts",
    "test": "vitest run",
    "typecheck": "pnpm run type-check",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webui.json --noEmit",
    "build:webui": "node scripts/build-webui.mjs",
    "build": "pnpm run type-check && pnpm run build:webui",
    "review-code-changes": "pnpm run lint && pnpm run lint:changed-tests && pnpm run type-check && pnpm run build:webui && pnpm run test",
    "audit:duplicates": "jscpd src tests --pattern \"**/*.{ts,tsx,js}\" --min-lines 8 --min-tokens 80 --reporters console,json --output .tmp/jscpd-src-tests",
    "score:manager-efficiency": "node .mimikit/tools/manager-efficiency-score.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "guard:file-length": "tsx scripts/check-file-length.ts",
    "manual:eval:traces-usage-ledger": "tsx scripts/traces-usage-ledger-eval.ts"
  },
  "type": "module",
  "version": "0.1.0"
